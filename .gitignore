# Binaries. Anchored to the root on purpose: a pattern with no slash matches
# any path component of that name at any depth, so a bare "flatdump" also
# matches the cmd/flatdump directory and quietly keeps the command out of the
# repository.
bin/
/flatdump
/flatdump.exe
*.exe
*.test

# Go
testdata/fuzz/
vendor/
*.out

# Local scratch — never commit sample payloads, they may not be yours to share
*.bin
*.har
scratch/
